{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "taskId",
    "episodeId",
    "propositionId",
    "transcriptSha256",
    "wordTimingSha256",
    "analysisSha256",
    "sourceWordIds",
    "spokenPhrase",
    "startWordId",
    "endWordId",
    "startFrame",
    "endFrameExclusive",
    "id",
    "createdAt",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "$ref": "#/$defs/id" },
    "taskId": { "type": "string", "minLength": 1 },
    "episodeId": { "$ref": "#/$defs/id" },
    "propositionId": { "$ref": "#/$defs/id" },
    "transcriptSha256": { "$ref": "#/$defs/sha" },
    "wordTimingSha256": { "$ref": "#/$defs/sha" },
    "analysisSha256": { "$ref": "#/$defs/sha" },
    "sourceWordIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" }
    },
    "spokenPhrase": { "type": "string", "minLength": 1 },
    "startWordId": { "$ref": "#/$defs/id" },
    "endWordId": { "$ref": "#/$defs/id" },
    "startFrame": { "type": "integer", "minimum": 0 },
    "endFrameExclusive": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "minLength": 1 },
    "receiptHash": { "$ref": "#/$defs/sha" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
