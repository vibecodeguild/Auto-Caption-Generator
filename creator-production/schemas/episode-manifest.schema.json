{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "episodeId",
    "revision",
    "state",
    "workflowLockHash",
    "lockedCutSha256",
    "lockedAudioSha256",
    "transcriptSha256",
    "wordTimingSha256",
    "fps", "canvas",
    "totalFrames",
    "sourceEventAnchors",
    "sequences",
    "transitionBoundaries",
    "chapters"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "episodeId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": ["INGESTING", "ANALYZING", "MATERIALIZING", "PREFLIGHT", "REVIEW_READY", "REVISION_REQUESTED", "APPROVED", "RENDERING", "RENDER_BLOCKED", "DELIVERED", "BLOCKED"]
    },
    "workflowLockHash": { "$ref": "#/$defs/sha256" },
    "lockedCutSha256": { "$ref": "#/$defs/sha256" },
    "lockedAudioSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "const": "" }] },
    "transcriptSha256": { "$ref": "#/$defs/sha256" },
    "wordTimingSha256": { "$ref": "#/$defs/sha256" },
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 1 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "totalFrames": { "type": "integer", "minimum": 1 },
    "sourceEventAnchors": { "type": "array", "items": { "$ref": "#/$defs/sourceEvent" } },
    "sequences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sequence" } },
    "transitionBoundaries": { "type": "array", "items": { "$ref": "#/$defs/boundary" } },
    "chapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chapter" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceEvent": {
      "type": "object",
      "required": ["id", "sourceRevisionHash", "absoluteFrame", "eventType", "measurementMethod", "detectorOrManualActor", "evaluatorVersion", "confidence", "evidenceRef", "creatorConfirmed"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceRevisionHash": { "$ref": "#/$defs/sha256" },
        "absoluteFrame": { "type": "integer", "minimum": 0 },
        "eventType": { "type": "string", "minLength": 1 },
        "measurementMethod": { "enum": ["admitted-detector", "creator-frame-selection"] },
        "detectorOrManualActor": { "type": "string", "minLength": 1 },
        "evaluatorVersion": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "creatorConfirmed": { "type": "boolean" }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "chapterId", "absoluteStartFrame", "absoluteEndFrameExclusive",
        "startWordId", "endWordId", "conceptId", "propositionId",
        "semanticBeatKind", "editorialJob", "semanticForm", "presentationRole",
        "narrativeStateRole", "sourceImplementationMode",
        "selectedCanvasTopology", "selectedCapabilityBindings",
        "assetRequirements", "resolvedAssetRefs", "resolvedImplementationSetRef",
        "consumedProfileDependencies",
        "compositionGraph", "policyExceptionRefs", "policyReceiptIds",
        "sequenceDecisionReceiptId", "routingConfidence", "unresolvedReasons"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "chapterId": { "$ref": "#/$defs/id" },
        "absoluteStartFrame": { "type": "integer", "minimum": 0 },
        "absoluteEndFrameExclusive": { "type": "integer", "minimum": 1 },
        "startWordId": { "type": ["string", "null"] },
        "endWordId": { "type": ["string", "null"] },
        "conceptId": { "$ref": "#/$defs/id" },
        "seriesId": { "type": ["string", "null"] },
        "callbackTo": { "type": ["string", "null"] },
        "propositionId": { "$ref": "#/$defs/id" },
        "semanticBeatKind": { "type": "string", "minLength": 1 },
        "editorialJob": { "type": "string", "minLength": 1 },
        "semanticForm": { "type": "string", "minLength": 1 },
        "presentationRole": { "enum": ["source-led", "authored", "hybrid"] },
        "narrativeStateRole": { "enum": ["establish", "develop", "payoff", "transition"] },
        "editorialDirective": { "$ref": "#/$defs/editorialDirective" },
        "selectedVisualFamilyId": { "type": ["string", "null"] },
        "sourceImplementationMode": {
          "enum": [null, "source-pass-through", "source-reframe", "compiled-capability", "project-composition"]
        },
        "selectedCanvasTopology": { "type": "string", "minLength": 1 },
        "selectedCapabilityBindings": { "type": "array", "items": { "type": "object" } },
        "assetRequirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetRequirement" }
        },
        "resolvedAssetRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetRef" }
        },
        "resolvedImplementationSetRef": { "type": "object", "minProperties": 1 },
        "consumedProfileDependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokenPaths", "fontIds", "policyIds", "thresholdIds", "preferenceIds", "referenceGrammarFields"],
          "properties": {
            "tokenPaths": { "type": "array", "items": { "type": "string" } },
            "fontIds": { "type": "array", "items": { "type": "string" } },
            "policyIds": { "type": "array", "items": { "type": "string" } },
            "thresholdIds": { "type": "array", "items": { "type": "string" } },
            "preferenceIds": { "type": "array", "items": { "type": "string" } },
            "referenceGrammarFields": { "type": "array", "items": { "type": "string" } }
          }
        },
        "compositionGraph": { "$ref": "#/$defs/graph" },
        "policyExceptionRefs": { "type": "array", "items": { "type": "string" } },
        "sourceOverrideRef": { "type": ["string", "null"] },
        "policyReceiptIds": { "type": "array", "items": { "type": "string" } },
        "sequenceDecisionReceiptId": { "$ref": "#/$defs/id" },
        "routingConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "unresolvedReasons": { "type": "array", "maxItems": 0 }
      }
    },
    "editorialDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualPurpose", "sourceStrategy", "spokenBeats", "meaningfulChanges", "intentionalVisualCarry", "copyReview"],
      "properties": {
        "visualPurpose": { "type": "string", "minLength": 1 },
        "sourceStrategy": { "enum": ["authored-explanation", "hybrid-emphasis", "screen-share-demo", "protected-performance", "intentional-clean-source"] },
        "spokenBeats": { "type": "array", "items": { "type": "object" } },
        "meaningfulChanges": { "type": "array", "items": { "type": "object" } },
        "intentionalVisualCarry": { "type": ["object", "null"] },
        "copyReview": { "type": "object" }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elements", "events"],
      "properties": {
        "elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/element" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "parentId", "zIndex", "geometry", "tokenBindings", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "minLength": 1 },
        "parentId": { "type": ["string", "null"] },
        "zIndex": { "type": "integer" },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" }, "y": { "type": "number" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "tokenBindings": { "type": "object" },
        "properties": { "type": "object" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetElementId", "operation", "absoluteFrame", "wordId", "sourceEventAnchorId", "durationFrames", "easing", "parameters", "contentBearing"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "targetElementId": { "$ref": "#/$defs/id" },
        "operation": { "type": "string", "minLength": 1 },
        "absoluteFrame": { "type": "integer", "minimum": 0 },
        "wordId": { "type": ["string", "null"] },
        "sourceEventAnchorId": { "type": ["string", "null"] },
        "durationFrames": { "type": "integer", "minimum": 0 },
        "easing": { "type": ["string", "null"] },
        "parameters": { "type": "object" },
        "contentBearing": { "type": "boolean" }
      }
    },
    "assetRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semanticJob", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "semanticJob": { "type": "string", "minLength": 1 },
        "required": { "const": true }
      }
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "mediaType", "rightsReceipt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "enum": ["image", "video", "audio", "svg", "font"] },
        "rightsReceipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "licenseId", "verifiedAt", "receiptHash"],
          "properties": {
            "status": { "const": "approved" },
            "source": { "type": "string", "minLength": 1 },
            "licenseId": { "type": "string", "minLength": 1 },
            "verifiedAt": { "type": "string", "minLength": 1 },
            "receiptHash": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromSequenceId", "toSequenceId", "mode", "implementationRef", "durationFrames", "overlapFrames", "chapterSafetyMargins", "policyReceiptIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "fromSequenceId": { "$ref": "#/$defs/id" },
        "toSequenceId": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["hard-cut", "none", "transition"] },
        "implementationRef": { "type": ["string", "null"] },
        "durationFrames": { "type": "integer", "minimum": 0 },
        "overlapFrames": { "type": "integer", "minimum": 0 },
        "chapterSafetyMargins": { "type": "object" },
        "policyReceiptIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "editorialSectionId", "title", "completionRationale", "absoluteStartFrame", "absoluteEndFrameExclusive"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "editorialSectionId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "completionRationale": { "type": "string", "minLength": 1 },
        "absoluteStartFrame": { "type": "integer", "minimum": 0 },
        "absoluteEndFrameExclusive": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
