{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "episodeId", "revision", "workflowLockHash",
    "lockedCutSha256", "transcriptSha256", "wordTimingSha256",
    "fps", "totalFrames", "sequences", "transitionIntents", "chapters",
    "unresolvedReasons"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "episodeId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "workflowLockHash": { "$ref": "#/$defs/sha" },
    "lockedCutSha256": { "$ref": "#/$defs/sha" },
    "transcriptSha256": { "$ref": "#/$defs/sha" },
    "wordTimingSha256": { "$ref": "#/$defs/sha" },
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 1 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "totalFrames": { "type": "integer", "minimum": 1 },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "chapterId", "absoluteStartFrame", "absoluteEndFrameExclusive",
          "startWordId", "endWordId", "conceptId", "seriesId", "callbackTo",
          "propositionId", "semanticBeatKind", "editorialJob", "semanticForm",
          "presentationRole", "narrativeStateRole", "candidateCanvasTopologies",
          "candidateCapabilityIds", "candidateAssessments", "assetRequirements", "semanticEvidenceRefs",
          "unresolvedReasons"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "chapterId": { "$ref": "#/$defs/id" },
          "absoluteStartFrame": { "type": "integer", "minimum": 0 },
          "absoluteEndFrameExclusive": { "type": "integer", "minimum": 1 },
          "startWordId": { "type": ["string", "null"] },
          "endWordId": { "type": ["string", "null"] },
          "conceptId": { "$ref": "#/$defs/id" },
          "seriesId": { "type": ["string", "null"] },
          "callbackTo": { "type": ["string", "null"] },
          "propositionId": { "$ref": "#/$defs/id" },
          "semanticBeatKind": { "type": "string", "minLength": 1 },
          "editorialJob": { "type": "string", "minLength": 1 },
          "semanticForm": { "type": "string", "minLength": 1 },
          "presentationRole": {
            "type": "string",
            "enum": ["source-led", "authored", "hybrid"]
          },
          "narrativeStateRole": {
            "type": "string",
            "enum": ["establish", "develop", "payoff", "transition"]
          },
          "editorialDirective": { "$ref": "#/$defs/editorialDirective" },
          "candidateCanvasTopologies": {
            "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
          },
          "candidateCapabilityIds": {
            "type": "array", "items": { "$ref": "#/$defs/id" }
          },
          "candidateAssessments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capabilityId", "recipeEvidence", "hardExclusions", "criterionValues", "assumptions"],
              "properties": {
                "capabilityId": { "$ref": "#/$defs/id" },
                "recipeEvidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sourceResourceId", "sourceSha256", "compatibleRecipeRole",
                    "compatibilityRationale"
                  ],
                  "properties": {
                    "sourceResourceId": { "$ref": "#/$defs/id" },
                    "sourceSha256": { "$ref": "#/$defs/sha" },
                    "compatibleRecipeRole": { "type": "string", "minLength": 1 },
                    "compatibilityRationale": { "type": "string", "minLength": 1 }
                  }
                },
                "hardExclusions": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "globallyBlocked", "creatorProhibited", "episodeRestricted",
                    "semanticallyIncompatible", "assetUnavailable", "speakerUnsafe",
                    "runtimeIncompatible", "contentCapacityFailure", "timingInvalid",
                    "repetitionProhibited"
                  ],
                  "properties": {
                    "globallyBlocked": { "type": "boolean" },
                    "creatorProhibited": { "type": "boolean" },
                    "episodeRestricted": { "type": "boolean" },
                    "semanticallyIncompatible": { "type": "boolean" },
                    "assetUnavailable": { "type": "boolean" },
                    "speakerUnsafe": { "type": "boolean" },
                    "runtimeIncompatible": { "type": "boolean" },
                    "contentCapacityFailure": { "type": "boolean" },
                    "timingInvalid": { "type": "boolean" },
                    "repetitionProhibited": { "type": "boolean" }
                  }
                },
                "criterionValues": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["semantic-fitness", "whole-video-contrast", "creator-preference", "implementation-maturity"],
                  "properties": {
                    "semantic-fitness": { "type": "number", "minimum": 0, "maximum": 1 },
                    "whole-video-contrast": { "type": "number", "minimum": 0, "maximum": 1 },
                    "creator-preference": { "type": "number", "minimum": 0, "maximum": 1 },
                    "implementation-maturity": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                },
                "assumptions": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "assetRequirements": {
            "type": "array",
            "items": { "$ref": "#/$defs/assetRequirement" }
          },
          "semanticEvidenceRefs": {
            "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
          },
          "unresolvedReasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "transitionIntents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fromSequenceId", "toSequenceId", "semanticIntent"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "fromSequenceId": { "$ref": "#/$defs/id" },
          "toSequenceId": { "$ref": "#/$defs/id" },
          "semanticIntent": { "type": "string", "minLength": 1 }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "editorialSectionId", "title", "completionRationale",
          "absoluteStartFrame", "absoluteEndFrameExclusive"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "editorialSectionId": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "completionRationale": { "type": "string", "minLength": 1 },
          "absoluteStartFrame": { "type": "integer", "minimum": 0 },
          "absoluteEndFrameExclusive": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "unresolvedReasons": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "editorialDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualPurpose", "sourceStrategy", "spokenBeats", "meaningfulChanges", "intentionalVisualCarry", "copyReview"],
      "properties": {
        "visualPurpose": { "type": "string", "minLength": 1 },
        "sourceStrategy": { "enum": ["authored-explanation", "hybrid-emphasis", "screen-share-demo", "protected-performance", "intentional-clean-source"] },
        "spokenBeats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sourceWordIds", "spokenPhrase", "onScreenText", "copyMode", "revealFrame", "fullyVisibleFrame", "exitFrameExclusive", "editorialPurpose", "copyEvidenceRef"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "sourceWordIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
              "spokenPhrase": { "type": "string", "minLength": 1 },
              "onScreenText": { "type": ["string", "null"] },
              "copyMode": { "enum": ["concise-editorial-label", "verbatim-command", "exact-ui-label", "none"] },
              "revealFrame": { "type": "integer", "minimum": 0 },
              "fullyVisibleFrame": { "type": "integer", "minimum": 0 },
              "exitFrameExclusive": { "type": "integer", "minimum": 1 },
              "editorialPurpose": { "type": "string", "minLength": 1 },
              "copyEvidenceRef": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "string", "pattern": "^copy-evidence:[0-9a-f]{64}$" }
                ]
              },
              "behavior": { "enum": ["single", "accumulate", "replace"] }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "copyMode": {
                      "enum": ["verbatim-command", "exact-ui-label"]
                    }
                  },
                  "required": ["copyMode"]
                },
                "then": {
                  "properties": {
                    "copyEvidenceRef": {
                      "type": "string",
                      "pattern": "^copy-evidence:[0-9a-f]{64}$"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "copyEvidenceRef": { "type": "null" }
                  }
                }
              }
            ]
          }
        },
        "meaningfulChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "absoluteFrame", "kind", "description", "spokenBeatId", "sourceVisualChangeRef", "verificationKind"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "absoluteFrame": { "type": "integer", "minimum": 0 },
              "kind": {
                "enum": [
                  "treatment-enter", "treatment-exit", "semantic-reveal",
                  "ui-callout", "screen-highlight", "speaker-reframe",
                  "data-change", "diagram-change", "celebration",
                  "supporting-visual", "performance-beat", "demonstration-beat"
                ]
              },
              "description": { "type": "string", "minLength": 1 },
              "spokenBeatId": { "type": ["string", "null"] },
              "sourceVisualChangeRef": { "type": ["string", "null"] },
              "verificationKind": { "enum": ["spoken-beat", "source-evidence"] }
            }
          }
        },
        "intentionalVisualCarry": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["carrySpanRef", "sourceEventId", "absoluteStartFrame", "absoluteEndFrameExclusive", "kind", "rationale", "evidenceRefs"],
              "properties": {
                "carrySpanRef": { "$ref": "#/$defs/id" },
                "sourceEventId": { "$ref": "#/$defs/id" },
                "absoluteStartFrame": { "type": "integer", "minimum": 0 },
                "absoluteEndFrameExclusive": { "type": "integer", "minimum": 1 },
                "kind": { "enum": ["performance", "demonstration"] },
                "rationale": { "type": "string", "minLength": 1 },
                "evidenceRefs": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "copyReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spellingPassed", "punctuationPassed", "grammarPassed"],
          "properties": {
            "spellingPassed": { "type": "boolean" },
            "punctuationPassed": { "type": "boolean" },
            "grammarPassed": { "type": "boolean" }
          }
        }
      }
    },
    "assetRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semanticJob", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "semanticJob": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean", "const": true }
      }
    }
  }
}
