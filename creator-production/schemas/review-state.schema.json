{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "episodeId", "revision", "buildHash", "approvalRecords", "activeNotes", "noteHistory", "autosave", "localizedInvalidation"],
  "properties": {
    "schemaVersion": {"const": 1},
    "episodeId": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "buildHash": {"$ref": "#/$defs/sha"},
    "approvalRecords": {"type": "array", "items": {"type": "object"}},
    "activeNotes": {"type": "array", "items": {"$ref": "#/$defs/note"}},
    "noteHistory": {"type": "array", "items": {"type": "object"}},
    "autosave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failureReason", "updatedAt"],
      "properties": {
        "status": {"enum": ["saved", "saving", "failed", "stale"]},
        "failureReason": {"type": ["string", "null"]},
        "updatedAt": {"type": "string", "minLength": 1}
      }
    },
    "localizedInvalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changedSequenceIds", "changedChapterIds", "reusableSequenceIds", "reusableChapterIds"],
      "properties": {
        "changedSequenceIds": {"type": "array", "items": {"type": "string"}},
        "changedChapterIds": {"type": "array", "items": {"type": "string"}},
        "reusableSequenceIds": {"type": "array", "items": {"type": "string"}},
        "reusableChapterIds": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "note": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "buildHash", "sequenceId", "elementId", "wordId", "absoluteFrame", "note", "status", "saveStatus", "savedAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "buildHash": {"$ref": "#/$defs/sha"},
        "sequenceId": {"type": "string", "minLength": 1},
        "elementId": {"type": ["string", "null"]},
        "wordId": {"type": ["string", "null"]},
        "absoluteFrame": {"type": "integer", "minimum": 0},
        "note": {"type": "string"},
        "status": {"enum": ["changes-requested", "ready-for-review"]},
        "saveStatus": {"enum": ["saved", "saving", "failed", "stale"]},
        "savedAt": {"type": "string", "minLength": 1}
      }
    }
  }
}
