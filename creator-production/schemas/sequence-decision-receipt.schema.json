{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "sequenceId", "rankingPolicyRef", "rankingMode", "criterionOrder", "stableTieBreaker", "semanticEvidenceRefs", "modelEvidence", "evaluatedCandidates", "rankedHardValidCapabilityIds", "selectedCapabilityId", "disposition", "unresolvedReasons", "deviationFromTopRanked", "createdAt", "receiptHash"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "sequenceId": {"type": "string", "minLength": 1},
    "rankingPolicyRef": {"type": "string", "minLength": 1},
    "rankingMode": {"enum": ["lexicographic", "weighted"]},
    "criterionOrder": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stableTieBreaker": {"const": "stable-capability-id"},
    "semanticEvidenceRefs": {"type": "array", "items": {"type": "string"}},
    "modelEvidence": {"type": "object"},
    "evaluatedCandidates": {"type": "array", "items": {"type": "object"}},
    "rankedHardValidCapabilityIds": {"type": "array", "items": {"type": "string"}},
    "selectedCapabilityId": {"type": ["string", "null"]},
    "disposition": {
      "enum": [
        "selected",
        "adaptation-required",
        "blocked-no-hard-valid-candidate",
        "source-led-no-authored-capability"
      ]
    },
    "unresolvedReasons": {"type": "array", "items": {"type": "string"}},
    "deviationFromTopRanked": {"type": ["object", "null"]},
    "createdAt": {"type": "string", "minLength": 1},
    "receiptHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
